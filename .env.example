# Supabase — copia estos valores desde tu proyecto en https://supabase.com
# Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# --- Solo servidor: NO son NEXT_PUBLIC, no se exponen al navegador ---

# Supabase service_role key (Settings -> API). La usa el cron para leer
# datos de todos los usuarios al enviar notificaciones. ¡Es secreta!
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Claves VAPID para Web Push. Genera un par con:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu-vapid-public-key
VAPID_PRIVATE_KEY=tu-vapid-private-key
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Secreto para proteger el endpoint del cron (/api/cron/notify).
# Invéntalo (una cadena larga y aleatoria).
CRON_SECRET=una-cadena-larga-y-aleatoria

# --- Mercado Pago (opcional): conectar cuenta para leer movimientos ---
# Crea una app en https://www.mercadopago.cl/developers → Tus integraciones.
MP_CLIENT_ID=tu-client-id
MP_CLIENT_SECRET=tu-client-secret
MP_REDIRECT_URI=https://life-hub-puce.vercel.app/api/mp/callback
